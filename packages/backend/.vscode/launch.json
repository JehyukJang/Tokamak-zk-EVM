{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug trusted-setup",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "trusted-setup"],
        "filter": { "name": "trusted-setup", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--output",
        "${workspaceFolder}/setup/trusted-setup/output/debug",
        "--fixed-tau"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug native MPC setup",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "mpc-setup"],
        "filter": { "name": "native_mpc_setup", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--intermediate",
        "${workspaceFolder}/setup/mpc-setup/output/native-debug.intermediate",
        "--output",
        "${workspaceFolder}/setup/mpc-setup/output/native-debug.final"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug Dusk-backed MPC ceremony",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "mpc-setup", "--bin", "dusk_backed_mpc_setup"],
        "filter": { "name": "dusk_backed_mpc_setup", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "ceremony",
        "--intermediate",
        "${workspaceFolder}/setup/mpc-setup/output/dusk-debug.intermediate",
        "--output",
        "${workspaceFolder}/setup/mpc-setup/output/dusk-debug.final"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug preprocess",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "preprocess", "--features", "development-crs-bypass"],
        "filter": { "name": "preprocess", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--allow-unverified-crs",
        "--crs",
        "${workspaceFolder}/setup/trusted-setup/output/debug",
        "--synthesizer-stat",
        "${workspaceFolder}/../frontend/synthesizer/outputs",
        "--output",
        "${workspaceFolder}/preprocess/output"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug prove",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "prove", "--features", "development-crs-bypass"],
        "filter": { "name": "prove", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--allow-unverified-crs",
        "--crs",
        "${workspaceFolder}/setup/trusted-setup/output/debug",
        "--synthesizer-stat",
        "${workspaceFolder}/../frontend/synthesizer/outputs",
        "--output",
        "${workspaceFolder}/prove/output"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug verify",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "verify", "--features", "development-crs-bypass"],
        "filter": { "name": "verify", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--allow-unverified-crs",
        "--crs",
        "${workspaceFolder}/setup/trusted-setup/output/debug",
        "--synthesizer-stat",
        "${workspaceFolder}/../frontend/synthesizer/outputs",
        "--preprocess",
        "${workspaceFolder}/preprocess/output",
        "--proof",
        "${workspaceFolder}/prove/output"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Measure prove timing",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--release", "-p", "prove", "--features", "timing", "--test", "timing", "--", "--nocapture"],
        "filter": { "name": "timing", "kind": "test" }
      },
      "program": "${cargo:program}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PROVE_QAP_PATH": "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "PROVE_SYNTHESIZER_PATH": "${workspaceFolder}/../frontend/synthesizer/outputs",
        "PROVE_SETUP_PATH": "${workspaceFolder}/setup/mpc-setup/output/native-debug.final",
        "PROVE_OUT_PATH": "${workspaceFolder}/prove/output",
        "TIMING_OUT": "${workspaceFolder}/prove/optimization/timing.release.json",
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "postDebugTask": "timing:json-to-md",
      "sourceLanguages": ["rust"]
    }
  ]
}
