{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug trusted-setup",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--release", "-p", "trusted-setup", "--features", "local-development-subcircuit-library"],
        "filter": { "name": "trusted-setup", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--output",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys",
        "--fixed-tau"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug native MPC setup",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--release", "-p", "mpc-setup", "--features", "local-development-subcircuit-library"],
        "filter": { "name": "native_mpc_setup", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--intermediate",
        "${workspaceFolder}/rust/setup/mpc-setup/output/native-debug.intermediate",
        "--output",
        "${workspaceFolder}/rust/setup/mpc-setup/output/native-debug.final"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Release Dusk-backed MPC to Google Drive",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--release", "-p", "mpc-setup", "--no-default-features", "--features", "production-npm-subcircuit-library", "--bin", "dusk_backed_mpc_setup"],
        "filter": { "name": "dusk_backed_mpc_setup", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "run",
        "--intermediate",
        "${workspaceFolder}/rust/setup/mpc-setup/output/dusk-release.intermediate",
        "--output",
        "${workspaceFolder}/rust/setup/mpc-setup/output/dusk-release.final"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug preprocess",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--release", "-p", "preprocess", "--features", "development-crs-bypass,local-development-subcircuit-library"],
        "filter": { "name": "preprocess", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--allow-unverified-crs",
        "--keys",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys",
        "--synthesizer-stat",
        "${workspaceFolder}/../frontend/synthesizer/outputs",
        "--output",
        "${workspaceFolder}/rust/preprocess/output"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug prove",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--release", "-p", "prove", "--features", "development-crs-bypass,local-development-subcircuit-library"],
        "filter": { "name": "prove", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--allow-unverified-crs",
        "--tau-sequence",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys/tau_sequence.rkyv",
        "--keys",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys",
        "--synthesizer-stat",
        "${workspaceFolder}/../frontend/synthesizer/outputs",
        "--output",
        "${workspaceFolder}/rust/prove/output"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug verify",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--release", "-p", "verify"],
        "filter": { "name": "verify", "kind": "bin" }
      },
      "program": "${cargo:program}",
      "args": [
        "--verifier-config",
        "${workspaceFolder}/rust/preprocess/output/verifier_config.json",
        "--instance",
        "${workspaceFolder}/../frontend/synthesizer/outputs/instance.json",
        "--proof",
        "${workspaceFolder}/rust/prove/output/univariate_proof.json"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Measure prove timing",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--locked", "--release", "-p", "prove", "--features", "timing,local-development-subcircuit-library", "--test", "timing", "--", "--nocapture"],
        "filter": { "name": "timing", "kind": "test" }
      },
      "program": "${cargo:program}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PROVE_QAP_PATH": "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "PROVE_SYNTHESIZER_PATH": "${workspaceFolder}/../frontend/synthesizer/outputs",
        "PROVE_SETUP_PATH": "${workspaceFolder}/rust/setup/mpc-setup/output/native-debug.final",
        "PROVE_OUT_PATH": "${workspaceFolder}/rust/prove/output",
        "TIMING_OUT": "${workspaceFolder}/rust/prove/optimization/timing.release.json",
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "postDebugTask": "timing:json-to-md",
      "sourceLanguages": ["rust"]
    }
  ]
}
