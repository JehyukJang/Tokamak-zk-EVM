{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug trusted-setup",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--locked",
          "--release",
          "-p",
          "trusted-setup",
          "--features",
          "local-development-subcircuit-library"
        ],
        "filter": {
          "name": "trusted-setup",
          "kind": "bin"
        }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--output",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys",
        "--fixed-tau"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "MPC: initialize Filecoin phase 2 (local QAP)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--locked",
          "--release",
          "-p",
          "mpc-setup",
          "--bin",
          "mpc"
        ],
        "filter": {
          "name": "mpc",
          "kind": "bin"
        }
      },
      "program": "${cargo:program}",
      "args": [
        "--mode",
        "development",
        "init",
        "--output",
        "${workspaceFolder}/rust/setup/mpc-setup/output/initial.mpc"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "MPC: publish verified ceremony to Google Drive (npm)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--locked", "--release", "-p", "mpc-setup", "--bin", "mpc"],
        "filter": {"name": "mpc", "kind": "bin"}
      },
      "program": "${cargo:program}",
      "args": [
        "--mode", "publish",
        "--library-version", "${input:mpcLibraryVersion}",
        "publish",
        "--input", "${input:mpcFinalTranscript}",
        "--output", "${input:mpcPublicationOutput}",
        "--filecoin-source", "${input:mpcFilecoinSource}"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}",
        "TOKAMAK_MPC_DRIVE_FOLDER_ID": "${env:TOKAMAK_MPC_DRIVE_FOLDER_ID}",
        "TOKAMAK_MPC_DRIVE_OAUTH_CLIENT_JSON_PATH": "${env:TOKAMAK_MPC_DRIVE_OAUTH_CLIENT_JSON_PATH}",
        "TOKAMAK_MPC_DRIVE_OAUTH_TOKEN_PATH": "${env:TOKAMAK_MPC_DRIVE_OAUTH_TOKEN_PATH}"
      },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Debug preprocess",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--locked",
          "--release",
          "-p",
          "preprocess",
          "--features",
          "development-crs-bypass,local-development-subcircuit-library"
        ],
        "filter": {
          "name": "preprocess",
          "kind": "bin"
        }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--allow-unverified-crs",
        "--keys",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys",
        "--synthesizer-stat",
        "${workspaceFolder}/../frontend/synthesizer/outputs",
        "--output",
        "${workspaceFolder}/rust/preprocess/output"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "Debug prove",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--locked",
          "--release",
          "-p",
          "prove",
          "--features",
          "development-crs-bypass,local-development-subcircuit-library"
        ],
        "filter": {
          "name": "prove",
          "kind": "bin"
        }
      },
      "program": "${cargo:program}",
      "args": [
        "--subcircuit-library",
        "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "--allow-unverified-crs",
        "--tau-sequence",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys/tau_sequence.rkyv",
        "--keys",
        "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys",
        "--synthesizer-stat",
        "${workspaceFolder}/../frontend/synthesizer/outputs",
        "--output",
        "${workspaceFolder}/rust/prove/output"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "Debug verify",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--locked",
          "--release",
          "-p",
          "verify"
        ],
        "env": {
          "TOKAMAK_VERIFIER_KEYS": "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys/verifier_keys.rkyv"
        },
        "filter": {
          "name": "verify",
          "kind": "bin"
        }
      },
      "program": "${cargo:program}",
      "args": [
        "--preprocess",
        "${workspaceFolder}/rust/preprocess/output/univariate_verifier_preprocess.bin",
        "--instance",
        "${workspaceFolder}/../frontend/synthesizer/outputs/instance.json",
        "--proof",
        "${workspaceFolder}/rust/prove/output/univariate_proof.bin"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "Measure prove timing",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--locked",
          "--release",
          "-p",
          "prove",
          "--features",
          "timing,local-development-subcircuit-library",
          "--test",
          "timing",
          "--",
          "--nocapture"
        ],
        "filter": {
          "name": "timing",
          "kind": "test"
        }
      },
      "program": "${cargo:program}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PROVE_QAP_PATH": "${workspaceFolder}/../frontend/qap-compiler/subcircuits/library",
        "PROVE_SYNTHESIZER_PATH": "${workspaceFolder}/../frontend/synthesizer/outputs",
        "PROVE_SETUP_PATH": "${workspaceFolder}/rust/setup/trusted-setup/output/debug-keys",
        "PROVE_OUT_PATH": "${workspaceFolder}/rust/prove/output",
        "TIMING_OUT": "${workspaceFolder}/rust/prove/optimization/timing.release.json",
        "ICICLE_BACKEND_INSTALL_DIR": "${workspaceFolder}/external-lib/mac/lib/backend",
        "DYLD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib",
        "LD_LIBRARY_PATH": "${workspaceFolder}/external-lib/mac/lib:${env:LD_LIBRARY_PATH}"
      },
      "postDebugTask": "timing:json-to-md",
      "sourceLanguages": [
        "rust"
      ]
    }
  ],
  "inputs": [
    {"id": "mpcLibraryVersion", "type": "promptString", "description": "Exact compatible npm subcircuit-library version for this publish ceremony"},
    {"id": "mpcFinalTranscript", "type": "promptString", "description": "Absolute path to the completed publish-mode transcript"},
    {"id": "mpcPublicationOutput", "type": "promptString", "description": "Absolute local CRS output path (reuse only for retrying this same publication)"},
    {"id": "mpcFilecoinSource", "type": "promptString", "description": "Absolute path to your original Filecoin challenge_19"}
  ]
}
