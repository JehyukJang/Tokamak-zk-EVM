{
  "name": "tokamak-zk-evm-monorepo",
  "version": "2.1.5",
  "description": "Tokamak zk-EVM: A tool that converts Ethereum transactions into Zero-Knowledge Proofs",
  "license": "MIT OR Apache-2.0",
  "author": "Tokamak Network",
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/frontend/qap-compiler",
    "packages/frontend/synthesizer/node-cli",
    "packages/frontend/synthesizer/web-app"
  ],
  "scripts": {
    "test": "lerna run test",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "clean": "lerna run clean",
    "docs:check": "node scripts/check-doc-readiness.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "version:sync:test": "node scripts/test-sync-version.mjs",
    "version:check": "npm run version:prepublication:check",
    "version:prepublication:check": "node scripts/check-version-sync.mjs --pre-publication",
    "version:production-snapshot:check": "node scripts/check-production-snapshot.mjs",
    "version:production-snapshot:refresh": "node scripts/refresh-production-snapshot.mjs",
    "version:production-snapshot:test": "node scripts/test-production-snapshot.mjs",
    "version:contract:check": "node scripts/check-version-contract.mjs",
    "synthesizer:build-tools:check": "tsc -p tsconfig.synthesizer-build-tools.json --pretty false && node scripts/check-synthesizer-build-tools.mjs"
  },
  "devDependencies": {
    "lerna": "^8.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "pip": "^0.0.1",
    "tsx": "^4.20.5"
  }
}
